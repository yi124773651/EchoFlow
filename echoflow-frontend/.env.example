# Backend API URL (used by next.config.ts rewrites, server-side only)
BACKEND_URL=http://localhost:8080

# Public API base path (used by client-side fetch in services/api.ts)
NEXT_PUBLIC_API_BASE=/api

# SSE direct backend URL (bypasses Next.js proxy to avoid response buffering)
# Must point to the backend directly; CORS is configured on the backend side
NEXT_PUBLIC_SSE_BASE=http://localhost:8080/api
